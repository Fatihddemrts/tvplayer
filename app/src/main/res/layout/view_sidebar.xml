<?xml version="1.0" encoding="utf-8"?>
<!--
  Kenar çubuğu (Netflix TV tarzı): üstte marka, altında Ara + bölümler,
  en altta Yenile ve Ayarlar. Odakta satır beyaza döner, etkin bölümün
  solunda kırmızı şerit durur. Dar ekranda yalnız ikonlar kalır.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/sidebar_width"
    android:layout_height="match_parent"
    android:background="@color/surface_container_lowest"
    android:orientation="vertical"
    android:paddingStart="@dimen/sidebar_pad"
    android:paddingEnd="@dimen/sidebar_pad"
    android:paddingTop="@dimen/safe_margin_y"
    android:paddingBottom="@dimen/safe_margin_y">

    <TextView
        android:id="@+id/nav_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:text="@string/app_name"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_headline_lg"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_search"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_search"
        android:text="@string/search_title" />

    <TextView
        android:id="@+id/nav_home"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_home"
        android:text="Ana Sayfa" />

    <TextView
        android:id="@+id/nav_live"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_live"
        android:text="@string/row_live" />

    <TextView
        android:id="@+id/nav_movies"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_movie"
        android:text="@string/row_vod" />

    <TextView
        android:id="@+id/nav_series"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_series"
        android:text="@string/row_series" />

    <TextView
        android:id="@+id/nav_music"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_music"
        android:text="@string/row_music" />

    <TextView
        android:id="@+id/nav_nas"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_nas"
        android:text="@string/row_nas" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/nav_refresh"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_refresh"
        android:text="@string/menu_refresh" />

    <TextView
        android:id="@+id/nav_settings"
        style="@style/SidebarItem"
        android:drawableStart="@drawable/ic_settings"
        android:text="@string/row_settings" />
</LinearLayout>
