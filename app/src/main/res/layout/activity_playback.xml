<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Motorun yüzeyi buraya bağlanır (VLCVideoLayout veya PlayerView) -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/buffering"
        style="@style/Spinner"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/status"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:text="VLC motoruna geçiliyor…"
        tools:visibility="visible" />

    <!--
      Kumanda paneli (Netflix tarzı): üstte başlık şeridi, altta zaman
      çubuğu ve düğmeler. Herhangi bir yön tuşu açar, odak hep
      Oynat/Duraklat düğmesine gelir; 5 sn tuşa basılmazsa gizlenir.
    -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Üst şerit: geri düğmesi (yalnız dokunmatik) + başlık + bölüm -->
        <LinearLayout
            android:id="@+id/controls_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_controls_top_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/safe_margin_x"
            android:paddingEnd="@dimen/safe_margin_x"
            android:paddingTop="@dimen/safe_margin_y"
            android:paddingBottom="40dp">

            <ImageView
                android:id="@+id/btn_back"
                style="@style/PlayerButton"
                android:contentDescription="@string/touch_back"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/now_title"
                    style="@style/Text.HeadlineMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="@dimen/text_headline_lg"
                    tools:text="The Mentalist" />

                <TextView
                    android:id="@+id/now_subtitle"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:text="S2 · B14"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/engine_label"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                tools:text="Motor: VLC" />
        </LinearLayout>

        <!-- Alt şerit: zaman çubuğu + düğmeler -->
        <LinearLayout
            android:id="@+id/controls_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_controls_scrim"
            android:orientation="vertical"
            android:paddingStart="@dimen/safe_margin_x"
            android:paddingEnd="@dimen/safe_margin_x"
            android:paddingTop="48dp"
            android:paddingBottom="@dimen/safe_margin_y">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time_current"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:textColor="@color/on_surface"
                    tools:text="00:12:30" />

                <!-- Odakta sol/sağ 10 sn sarar (bkz. PlaybackActivity) -->
                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:nextFocusDown="@+id/btn_play_pause"
                    android:progressBackgroundTint="#80FFFFFF"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/primary" />

                <TextView
                    android:id="@+id/time_total"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="48dp"
                    android:textColor="@color/on_surface"
                    tools:text="01:48:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Oynat/Duraklat en solda ve en büyük: panel açılınca odak burada. -->
                <ImageView
                    android:id="@+id/btn_play_pause"
                    style="@style/PlayerButton"
                    android:layout_width="@dimen/player_button_size_main"
                    android:layout_height="@dimen/player_button_size_main"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Oynat/Duraklat"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_pause" />

                <ImageView
                    android:id="@+id/btn_rewind"
                    style="@style/PlayerButton"
                    android:contentDescription="Geri sar"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_rewind" />

                <ImageView
                    android:id="@+id/btn_forward"
                    style="@style/PlayerButton"
                    android:contentDescription="İleri sar"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_forward" />

                <ImageView
                    android:id="@+id/btn_prev"
                    style="@style/PlayerButton"
                    android:contentDescription="Önceki"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_prev" />

                <ImageView
                    android:id="@+id/btn_next"
                    style="@style/PlayerButton"
                    android:contentDescription="Sonraki"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_next" />

                <!-- Ses: yalnız dokunmatik. Televizyon kendi kumandasının ses tuşunu kullanır. -->
                <ImageView
                    android:id="@+id/btn_volume"
                    style="@style/PlayerButton"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@string/touch_mute"
                    android:src="@drawable/ic_volume_up"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <SeekBar
                    android:id="@+id/volume"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/touch_volume"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/primary"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btn_audio"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/track_audio"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_audio" />

                <ImageView
                    android:id="@+id/btn_subtitle"
                    style="@style/PlayerButton"
                    android:contentDescription="@string/track_subtitle"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_subtitle" />

                <ImageView
                    android:id="@+id/btn_engine"
                    style="@style/PlayerButton"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="@string/switch_engine"
                    android:nextFocusUp="@id/seek"
                    android:src="@drawable/ic_engine" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
