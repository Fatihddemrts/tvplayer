<?xml version="1.0" encoding="utf-8"?>
<!--
  Ana ekran iki görünüm barındırır:
   · Ana Sayfa  → hero + yatay raylar (home_scroll)
   · Canlı/Film/Dizi → solda kategoriler, sağda içerik (browse_pane)

  En solda her zaman ince ikon şeridi durur.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!--
      ===== Ana Sayfa (Netflix tarzı) =====
      Üstte sabit "billboard": odaklanan içeriğin görseli sağ üstte, adı,
      künyesi, özeti ve Oynat/Detaylar düğmeleri solda. Altında raflar kayar;
      kumandayla bir karta gelindiğinde billboard o içeriğe döner.
    -->
    <FrameLayout
        android:id="@+id/home_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sidebar_width">

        <!-- Görsel + iki karartma: soldan (metin için) ve alttan (raflar için) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_backdrop_height">

            <ImageView
                android:id="@+id/hero_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_scrim" />

            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_hero_scrim_bottom" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Billboard bilgisi -->
            <LinearLayout
                android:id="@+id/hero_info"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="@dimen/safe_margin_x"
                android:paddingEnd="@dimen/safe_margin_x"
                android:paddingTop="@dimen/safe_margin_y"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/hero_kicker"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:textColor="@color/primary"
                    tools:text="İzlemeye devam et" />

                <TextView
                    android:id="@+id/hero_title"
                    style="@style/Text.HeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:maxWidth="@dimen/hero_text_max_width"
                    tools:text="The Mentalist" />

                <TextView
                    android:id="@+id/hero_meta"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="@dimen/hero_text_max_width"
                    android:textColor="@color/on_surface"
                    tools:text="2008 · ★ 8.1 · Suç, Dram" />

                <TextView
                    android:id="@+id/hero_desc"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="3"
                    android:maxWidth="@dimen/hero_text_max_width"
                    tools:text="Sahte bir medyum, Kaliforniya Soruşturma Bürosu'na danışmanlık yapıyor." />

                <LinearLayout
                    android:id="@+id/hero_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hero_play"
                        style="@style/HeroButton"
                        android:text="▶  Oynat" />

                    <TextView
                        android:id="@+id/hero_more"
                        style="@style/HeroButton"
                        android:layout_marginStart="10dp"
                        android:text="ⓘ  Detaylar" />
                </LinearLayout>
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/home_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fadingEdgeLength="24dp"
                android:paddingBottom="@dimen/safe_margin_y"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/safe_margin_x"
                    android:paddingEnd="@dimen/safe_margin_x">

                    <LinearLayout
                        android:id="@+id/rails_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/empty_hint"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/empty_hint"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Gözat: kategoriler + içerik ===== -->
    <LinearLayout
        android:id="@+id/browse_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sidebar_width"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Sol sütun: kategoriler -->
        <LinearLayout
            android:layout_width="@dimen/category_width"
            android:layout_height="match_parent"
            android:background="@color/surface_container_lowest"
            android:orientation="vertical"
            android:paddingTop="@dimen/safe_margin_y"
            android:paddingBottom="@dimen/safe_margin_y">

            <TextView
                android:id="@+id/section_title"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                tools:text="Filmler" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/category_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Sağ sütun: seçili kategorinin içeriği -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="@dimen/safe_margin_x"
            android:paddingTop="@dimen/safe_margin_y"
            android:paddingBottom="@dimen/safe_margin_y">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/content_title"
                    style="@style/Text.HeadlineMd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="FILM: En Yeniler 2025 · 499" />

                <TextView
                    android:id="@+id/btn_search"
                    style="@style/ToolbarChip"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="6dp"
                    android:text="@string/search_title" />

                <TextView
                    android:id="@+id/btn_view_mode"
                    style="@style/ToolbarChip"
                    tools:text="Kılavuz" />

                <TextView
                    android:id="@+id/btn_sort"
                    style="@style/ToolbarChip"
                    android:layout_marginStart="8dp"
                    tools:text="Sıra: Ada göre" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/content_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/content_empty"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    tools:text="Bu kategoride içerik yok" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 3: ikon şeridi her zaman üstte -->
    <include
        android:id="@+id/sidebar"
        layout="@layout/view_sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <ProgressBar
            style="@style/Spinner"
            android:id="@+id/loading"
        
        android:layout_gravity="center"
        
        android:visibility="gone" />
</FrameLayout>
