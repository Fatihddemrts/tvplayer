<?xml version="1.0" encoding="utf-8"?>
<!--
  Kenar çubuğu satırı. Odak: beyaz dolgu (yazı siyaha döner, bkz.
  color/nav_item_text). Etkin bölüm: solda kırmızı şerit.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1AFFFFFF" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:gravity="start|fill_vertical" android:width="3dp"
                android:top="8dp" android:bottom="8dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
